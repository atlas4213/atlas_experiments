import scanpy as sc
import pandas as pd 
import numpy as np 
import matplotlib.pyplot as plt

sc.settings.verbosity = 3
sc.settings.set_figure_params(dpi=100,facecolor="white")

adata = sc.datasets.pbmc3k()

adata


# 1. Identify mitochondrial genes
adata.var["mt"] = adata.var_names.str.startswith("MT-")

# 2. Calculate QC metrics
sc.pp.calculate_qc_metrics(
    adata,
    qc_vars=["mt"],
    percent_top=None,
    log1p=False,
    inplace=True
)

sc.pl.violin(
    adata,
    ["n_genes_by_counts", "total_counts", "pct_counts_mt"],
    jitter=0.4,
    multi_panel=True
)

# 3. Filter cells with fewer than 200 genes and doesnt appear in at least 3 cells 
sc.pp.filter_cells(adata, min_genes=200)
sc.pp.filter_genes(adata, min_cells=3)

#filter out cellsl with more than 2500 genes and less than 5% MT percent counts
adata = adata[adata.obs["n_genes_by_counts"] < 2500, :].copy()
adata = adata[adata.obs["pct_counts_mt"] < 5, :].copy()

# Save the raw count in the adata object
adata.layers["counts"] = adata.X.copy()

# 5. Normalize counts to 10,000 per cell
sc.pp.normalize_total(adata, target_sum=1e4)

# 6. Log-transform the data
sc.pp.log1p(adata)

# Optional: save log-normalized data
adata.raw = adata

# 7. Select highly variable genes
sc.pp.highly_variable_genes(
    adata,
    min_mean=0.0125,
    max_mean=3,
    min_disp=0.5
)

# Subset to highly variable genes
adata = adata[:, adata.var["highly_variable"]].copy()

# Optional: scale data before PCA
sc.pp.scale(adata, max_value=10)

# 8. Run PCA
sc.tl.pca(adata, svd_solver="arpack")

# 9. Build nearest-neighbor graph
sc.pp.neighbors(adata, n_neighbors=10, n_pcs=40)

# 10. Run Leiden clustering
sc.tl.leiden(adata, 
    resolution=0.5,
    flavor="igraph",
    n_iterations=2,
    directed=False)

# 11. Generate UMAP
sc.tl.umap(adata)

# Plot UMAP
sc.pl.umap(adata, color=["leiden"])


# Add some marker genes to start identifiying cell types 
# Marker	Cell type
# MS4A1	B cells
# CD3D	T cells
# NKG7	NK / cytotoxic T cells
# LYZ	Monocytes
# PPBP	Platelets
# FCGR3A

sc.pl.umap(
    adata,
    color=["leiden", "MS4A1", "CD3D", "NKG7", "LYZ", "PPBP"]
)
