#How to load ccts snakemakeslurm module

#export MODULEPATH=/share/apps/ngs-ccts/modulefiles:${MODULEPATH}

from os.path import join
configfile: "config.json"


#MODULES
PURGE = "module purge"
SHARED= "module load shared"
BASE="module load rc-base"
LOAD_FQC="module load FastQC/0.11.5-Java-1.8.0_74"
LOAD_MULTIQC="module load MultiQC/1.4-foss-2016b-Python-2.7.12"
LOAD_STAR="module load STAR/2.5.2a-foss-2016a"
LOAD_SAMTOOLS="module load SAMtools/1.6-intel-2017a"
LOAD_HTSEQ="module load HTSeq/0.6.1p1-foss-2016b-Python-2.7.12"
LOAD_TRIM="module load Trim_Galore/0.4.4-foss-2016b"
UNLOAD_TRIM="module unload zlib/1.2.8-intel-2016a"

#reference Directories
#MUST CHANGE WORKING DIRECTORY EACH TIME
WOR_DIR="/data/temporary-scratch/atlas4/"
multi_dir= "multiqc"
rule all:
    input:
        expand(WOR_DIR + 'fastqc/'  + '{sample}_R{read}_001_fastqc.zip' , sample = config["samples"], read = ['1','2']),
        expand(WOR_DIR + 'trimmed/' + '{sample}_R{read}_001_val_{read}.fq' , sample = config["samples"], read = ['1','2']),
        expand(WOR_DIR + 'trimmed_fastqc/' + '{sample}_R{read}_001_val_{read}_fastqc.zip' , sample = config['samples'], read = ['1','2']),
        expand(WOR_DIR + 'star/' + '{sample}.Aligned.out.sam' , sample= config["samples"], read = ['1', '2']),
        expand(WOR_DIR + 'count/' + '{sample}.count' , sample= config["samples"])

#runs fastqc on all samples and creates new directory called "fastqc"
rule fastqc:
    input:r1= WOR_DIR + '{sample}_R{read}_001.fastq'
    output:r1= WOR_DIR+ 'fastqc/' + '{sample}_R{read}_001_fastqc.zip'
    run: shell('{LOAD_FQC} && ' ' fastqc -f fastq {input} --outdir ' + WOR_DIR + 'fastqc/')

#runs trim galore on all samples and creates new directory named "trimmed"
rule trim:
    input:r1=WOR_DIR + '{sample}_R1_001.fastq', r2=WOR_DIR + '{sample}_R2_001.fastq'
    output:r1 = WOR_DIR + 'trimmed/' + '{sample}_R1_001_val_1.fq' , r2 = WOR_DIR + 'trimmed/' + '{sample}_R2_001_val_2.fq'
    run: shell('{PURGE} && {SHARED} && {BASE} && {LOAD_TRIM} && ' 'trim_galore --phred33 --nextera  --paired {input.r1} {input.r2} -o ' + WOR_DIR + 'trimmed/')

#runs fastqc on the trimmed samples and creates a new directory called "trimmed_fastqc"
rule trim_fastqc:
    input: r1 = WOR_DIR + 'trimmed/' + '{sample}_R{read}_001_val_{read}.fq'
    output: r1 = WOR_DIR + 'trimmed_fastqc/' + '{sample}_R{read}_001_val_{read}_fastqc.zip'
    run: shell('{LOAD_FQC} && ' ' fastqc -f fastq {input} --outdir ' + WOR_DIR + 'trimmed_fastqc/')

#runs star alignment
rule star:
    input: r1=WOR_DIR + 'trimmed/' + '{sample}_R1_001_val_1.fq',r2=WOR_DIR + 'trimmed/' + '{sample}_R2_001_val_2.fq'
    output: WOR_DIR + 'star/' + '{sample}.Aligned.out.sam',
            WOR_DIR + 'star/' + '{sample}.SJ.out.tab',
            WOR_DIR + 'star/' + '{sample}.Log.out',
            WOR_DIR + 'star/' + '{sample}.Log.final.out',
            WOR_DIR + 'star/' + '{sample}.Log.progress.out'
    run:shell('{PURGE} && {SHARED} && {BASE} && {LOAD_STAR} && STAR --runThreadN 10 --genomeDir /data/project/bioinfx/ref/star/igenome/Mus_musculus/UCSC/mm10/ --outFilterMultimapNmax 20 --alignSJoverhangMin 8 --alignSJDBoverhangMin 1 --outFilterMismatchNmax 999 --alignIntronMin 20 --alignIntronMax 1000000 --alignMatesGapMax 1000000  --readFilesIn {input.r1} {input.r2} --outFileNamePrefix ' + join(WOR_DIR + 'star/', '{wildcards.sample}' ) + '.' )

#runs htseq-count on all samples and creates a new directroy named "count"
rule count:
    input: r1=WOR_DIR + 'star/' + '{sample}.Aligned.out.sam'
    output: r1 = WOR_DIR + 'count/' + '{sample}.count'
    run:shell('{PURGE} && {SHARED} && {BASE} && {UNLOAD_TRIM} && {LOAD_HTSEQ} && htseq-count -s no -a 10 {input} /data/project/bioinfx/ref/igenome/Mus_musculus/UCSC/mm10/Annotation/Genes/genes.gtf > {output}')

#runs multiqc on all directories
rule multiqc:
    input: fastqc =expand(WOR_DIR+ 'fastqc/' + '{sample}_R{read}_001_fastqc.zip', sample = config["samples"], read = ['1','2']), trimmed= expand(WOR_DIR + 'trimmed/' + '{sample}_R{read}_001_val_{read}.fq', sample = config["samples"], read=['1','2']), star= expand(WOR_DIR + 'star/' + '{sample}.Aligned.out.sam', sample = config["samples"])
    output: dir= WOR_DIR + multi_dir
    run:shell('{LOAD_MULTIQC} && multiqc {WOR_DIR} -o {output.dir}')
